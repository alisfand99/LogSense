# LogSense Environment Variables

# Gemini API
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash

# Database
DATABASE_URL=postgresql+asyncpg://logsense:logsense@db:5432/logsense
POSTGRES_USER=logsense
POSTGRES_PASSWORD=logsense
POSTGRES_DB=logsense

# Redis
REDIS_URL=redis://redis:6379/0

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
LOG_LEVEL=info

# Frontend
VITE_API_URL=http://localhost:8000
